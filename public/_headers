# Security headers for every file Cloudflare serves from public/ (worker.mjs adds the same to /keydous/*).
# Must match SECURITY in keydous.mjs: tests/headers.test.mjs checks it. Not used by server.mjs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: hid=(self), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
